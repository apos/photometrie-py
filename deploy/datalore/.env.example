# Vorlage fuer deploy/datalore/.env — bootstrap.sh legt .env daraus an und erzeugt DB_PASSWORD. .env enthaelt Geheimnisse: nie committen, nie in eine Registry/ein Archiv packen (chmod 600).

# --- Version und Namen -------------------------------------------------------
DATALORE_VERSION=2026.4.1
COMPOSE_PROJECT_NAME=datalore
# Agent-Image (Name:Tag wie es build.sh baut bzw. imgstore laedt)
AGENT_IMAGE=varphot-datalore-agent:2026.4.1-py312

# --- Zugang ------------------------------------------------------------------
# Adresse, an die der Server den Port bindet: 127.0.0.1 (nur dieser Rechner), 0.0.0.0 (alle), oder eine bestimmte Adresse (z. B. WireGuard/Tailscale)
DATALORE_BIND=127.0.0.1
DATALORE_PORT=8080
# URL, unter der du Datalore im Browser oeffnest (genau eine; mit Schema und Port)
DATALORE_PUBLIC_URL=http://127.0.0.1:8080

# --- Geheimnis (bootstrap.sh setzt es, wenn leer) ----------------------------
DB_PASSWORD=

# --- Docker ------------------------------------------------------------------
# Pfad des Docker-Sockets AUF DEM HOST. Linux/Docker Desktop/OrbStack: /var/run/docker.sock; rootless Docker: /run/user/1000/docker.sock; Podman: siehe README
DOCKER_SOCK=/var/run/docker.sock

# --- Ordner auf dem Host (absolute Pfade) ------------------------------------
# Datenordner (Sitzungen, Ergebnisse, observer.json); im Agent unter /work/PHOTOMETRIE_PY_DATA
VARPHOT_DATA_DIR=/Users/apos/Nextcloud/WORKSPACE/ASTRO/PHOTOMETRIE_PY_DATA
# Austauschordner Datalore <-> Host; im Agent unter /exchange
EXCHANGE_DIR=/Users/apos/Nextcloud/WORKSPACE/ASTRO/DATALORE_EXCHANGE
# Optional: Git-Klon von varphot, der die Momentaufnahme im Image ersetzt (schreibgeschuetzt eingehaengt; leer = Stand aus dem Image)
VARPHOT_REPO_DIR=

# --- ASTAP-Sterndatenbank ----------------------------------------------------
# Name des Docker-Volumes, das astap-db.sh befuellt und in die Agents (/opt/astap_db) einhaengt
ASTAP_DB_VOLUME=varphot-astap-db
# Pakete (.deb oder .zip, mit Leerzeichen getrennt); Standard: D80 (grosse Felder, 1,2 GB) und G17 (kleine Felder, 0,5 GB)
ASTAP_DB_URLS="https://sourceforge.net/projects/astap-program/files/star_databases/d80_star_database.deb/download https://sourceforge.net/projects/hnsky/files/star_databases/g17_star_database_mag17.zip/download"

# --- Optional: GPU-Agent (nur Linux mit NVIDIA Container Toolkit; die Pipeline selbst nutzt keine GPU) ---
ENABLE_GPU_AGENT=0
